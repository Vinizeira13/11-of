# Supabase: a compatible database schema and RPCs are required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin for metadata, links and payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only cart signing secret, at least 32 characters in production.
CART_SECRET=

# PagNet credentials. Both remain server-side.
# Leaving both empty selects the payment client's mock charge mode.
PAGNET_PUBLIC_KEY=
PAGNET_SECRET_KEY=
# PAGNET_API_BASE=https://api.pagnetbrasil.com/v1

# Optional administration. The database must implement admin_update_delivery.
ADMIN_PASSWORD=
ADMIN_RPC_TOKEN=

# Optional: set to 1 to disable the breaking-news experience.
# BREAKING_NEWS_OFF=1
